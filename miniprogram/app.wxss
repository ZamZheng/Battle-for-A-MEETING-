page { background:#f5f7fb; color:#162339; font-size:28rpx; font-family: -apple-system, sans-serif; }
.container { padding:30rpx; padding-bottom:70rpx; } .card { background:#fff; border-radius:24rpx; padding:30rpx; margin-bottom:24rpx; }
.title { font-size:42rpx; font-weight:700; margin:18rpx 0; } .heading { font-size:32rpx; font-weight:600; margin-bottom:20rpx; }
.muted { color:#68758a; font-size:25rpx; line-height:1.7; } .badge { background:#e9efff; color:#3256a3; padding:10rpx 18rpx; border-radius:12rpx; font-size:24rpx; display:inline-block; }
.notice { padding:22rpx; border-radius:16rpx; background:#fff2d9; color:#735015; font-size:25rpx; line-height:1.6; margin-bottom:24rpx; }
button { font-size:28rpx; margin-top:18rpx; border-radius:16rpx; } button.primary { background:#315fe9; color:white; } button::after { border:0; }
input, textarea { box-sizing:border-box; width:100%; padding:20rpx; background:#f4f6fa; border-radius:12rpx; margin:12rpx 0 26rpx; } textarea { height:160rpx; }
.label { font-weight:500; margin-top:20rpx; display:block; } .row { display:flex; align-items:center; gap:16rpx; flex-wrap:wrap; } .grow { flex:1; }
.error { color:#a32424; background:#ffeded; padding:20rpx; border-radius:12rpx; margin-bottom:20rpx; } .small { font-size:24rpx; } .divider { border-top:1rpx solid #e8ecf3; margin:24rpx 0; }
.slot { border:1rpx solid #e1e7f0; border-radius:16rpx; padding:22rpx; margin-top:20rpx; } .bar { display:flex; height:20rpx; overflow:hidden; border-radius:8rpx; background:#edf0f5; margin:16rpx 0; }
.yes { background:#bee9d7; color:#165d43; } .maybe { background:#ffe2a1; color:#805b0c; } .no { background:#f5c5c5; color:#8a2828; } .blank { background:#e9edf3; color:#647185; }
.choice { padding:16rpx 24rpx; border-radius:12rpx; border:3rpx solid transparent; } .selected { border-color:#254cbd; font-weight:bold; }
.avatar { width:84rpx; height:84rpx; border-radius:50%; } .danger { color:#a32424; } .link { color:#315fe9; } .picker { padding:20rpx; background:#f4f6fa; border-radius:12rpx; margin-top:12rpx; }
