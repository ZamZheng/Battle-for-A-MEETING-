input { height:88rpx; min-height:88rpx; padding:0 20rpx; font-size:28rpx; }
textarea { height:200rpx; }
.edit-field { position:relative; }
.edit-field.invalid::after { content:""; position:absolute; top:-8rpx; bottom:-8rpx; left:-8rpx; right:-8rpx; border:2rpx dashed #c33e4b; border-radius:14rpx; pointer-events:none; }
.field-error { color:#ae2f3b; font-size:24rpx; line-height:1.6; margin:12rpx 0; }
.member-row { border-bottom:1rpx solid #e8ecf3; padding:18rpx 0; }
.member-inputs { display:flex; gap:12rpx; }
.member-inputs input { margin:0; min-width:0; }
.member-name { flex:2; }.member-note { flex:3; }
.member-actions { display:flex; align-items:center; gap:12rpx; margin-top:12rpx; flex-wrap:wrap; }
.member-kind { background:#f4f6fa; padding:12rpx; border-radius:10rpx; font-size:24rpx; }
.member-actions button { margin:0; padding:0 14rpx; font-size:24rpx; line-height:60rpx; }
.edit-actions { display:flex; gap:16rpx; }
.edit-actions button { flex:1; margin:0; font-size:28rpx; }
