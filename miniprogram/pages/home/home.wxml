<view class="container">
  <view class="badge">首页调整版 A05 · 本地模拟</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="card">
    <view class="heading">有会议需要协调时间？</view>
    <view class="muted">粘贴发起人发来的邀请链接，进入会议选择时间。</view>
    <input placeholder="在这里粘贴会议邀请链接" value="{{invite}}" bindinput="typeInvite"/>
    <button class="primary" bindtap="join">进入会议</button>
  </view>
  <view class="card">
    <view class="heading">想发起一场会议？</view>
    <view class="label">当前测试身份</view>
    <picker range="{{identities}}" range-key="name" value="{{actorIndex}}" bindchange="switchActor"><view class="picker">{{identities[actorIndex].name}} ▾</view></picker>
    <button class="primary" bindtap="create">发起会议协调</button>
  </view>
  <view class="card" id="my-meetings">
    <view class="heading">我的会议</view>
    <view class="muted">已加入或发起的会议，随时回来查看。</view>
    <view wx:if="{{!meetings.length}}" class="muted">还没有会议，先通过邀请加入，或发起一场会议。</view>
    <view wx:for="{{meetings}}" wx:key="id" class="slot {{item.id === highlightId ? 'meeting-highlight' : ''}}" data-id="{{item.id}}" bindtap="open">
      <view wx:if="{{item.id === highlightId}}" class="meeting-highlight-label">刚刚更新 · 已保存你的选择</view>
      <view class="meeting-list-heading"><view class="meeting-list-title">{{item.title}} →</view><text wx:if="{{item.isOwner}}" class="meeting-owner-badge">你是发起人</text></view>
      <view class="muted">{{item.status === 'locked' ? '已锁定' : item.status === 'cancelled' ? '已取消' : '收集／待确认'}} · 更新 {{item.updatedAt}}</view>
    </view>
  </view>
  <view class="notice">本版用于流程试用。数据仅保存在本机，切换身份可模拟多人，不代表真实微信登录或跨设备共享。</view>
  <button class="danger" bindtap="reset">清空本机模拟数据</button>
</view>
