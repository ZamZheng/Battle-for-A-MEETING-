
.heatmap { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; margin:24rpx 0; }
.heatcell { padding:18rpx; border-radius:14rpx; line-height:1.8; }
.heat-strong { background:#217553; color:#fff; } .heat-medium { background:#9bd8be; color:#184e38; }
.heat-light { background:#dff2e9; color:#215d45; } .heat-empty { background:#edf0f5; color:#59677b; }

/* Keep the time range primary in both voting cards and the compact heatmap. */
.slot-date { font-size:24rpx; font-weight:400; line-height:1.5; opacity:.8; margin-bottom:6rpx; }
.slot .slot-time { font-size:40rpx; font-weight:700; line-height:1.3; letter-spacing:.5rpx; font-variant-numeric:tabular-nums; }
.heatcell .heat-time { font-size:34rpx; font-weight:700; line-height:1.35; white-space:nowrap; font-variant-numeric:tabular-nums; margin:8rpx 0 12rpx; }

.coordination-step { color:#536582; font-size:24rpx; margin:24rpx 0 12rpx; }

.current-role { margin-top:20rpx; }
.meeting-info-actions { display:flex; gap:16rpx; margin-top:18rpx; }
.meeting-info-actions button { flex:1; min-width:0; margin:0; padding:12rpx; font-size:26rpx; line-height:1.6; }

.participant-card .heatmap { margin-top:0; }
button.batch-choice { font-weight:600; }
button.batch-yes { background:#217553; color:#fff; }
button.batch-maybe { background:#ffe2a1; color:#805b0c; }
button.batch-no { background:#f5c5c5; color:#8a2828; }

.submission-overlay { position:fixed; top:0; left:0; right:0; bottom:0; z-index:100; background:rgba(20,32,52,.35); display:flex; justify-content:center; align-items:center; padding:40rpx; }
.submission-message { width:100%; max-width:560rpx; box-sizing:border-box; padding:44rpx 36rpx; background:#fff; border-radius:28rpx; text-align:center; }
.submission-check { width:80rpx; height:80rpx; margin:0 auto 24rpx; border-radius:50%; background:#e0f2e9; color:#217553; font-size:46rpx; line-height:80rpx; }
.submission-title { font-size:36rpx; font-weight:700; }
.submission-text { font-size:28rpx; line-height:1.7; color:#536582; margin-top:20rpx; }
.submission-error { font-size:25rpx; color:#a32424; line-height:1.6; margin-top:20rpx; }
button.submission-ok { width:100%; margin-top:28rpx; }

button.owner-invite-button { width:100%; box-sizing:border-box; white-space:nowrap; }
button.owner-round-button { width:100%; box-sizing:border-box; padding:18rpx 24rpx; line-height:1.5; }

.correction-list { margin-top:16rpx; border-top:1rpx solid #e8ecf3; border-bottom:1rpx solid #e8ecf3; }
.correction-row { height:160rpx; box-sizing:border-box; padding:20rpx 0; border-bottom:1rpx solid #e8ecf3; display:grid; grid-template-columns:minmax(0,1fr) 28rpx minmax(0,1fr) 104rpx; gap:10rpx; align-items:center; }
.correction-person { display:flex; align-items:center; gap:8rpx; min-width:0; }
.correction-name { flex:1; min-width:0; font-size:28rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.correction-avatar { width:52rpx; height:52rpx; flex-shrink:0; border-radius:50%; }
.correction-avatar-empty { background:#edf0f5; color:#7a8596; font-size:18rpx; line-height:52rpx; text-align:center; }
.correction-arrow { text-align:center; color:#7a8596; font-size:28rpx; }
.correction-target { min-width:0; }
.correction-target-value { background:#f4f6fa; border-radius:12rpx; padding:16rpx 10rpx; font-size:25rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
button.correction-confirm { width:104rpx; min-width:0; margin:0; padding:0; font-size:24rpx; line-height:72rpx; background:#315fe9; color:#fff; }
button.correction-confirm[disabled] { background:#e9edf3; color:#7a8596; }
.correction-scroll-hint { margin-top:12rpx; }

.participant-prompt { background:#edf3ff; border-left:6rpx solid #315fe9; border-radius:12rpx; padding:22rpx; margin-bottom:14rpx; }
.participant-prompt-title { color:#244c9e; font-size:32rpx; font-weight:700; line-height:1.55; }
.heatmap-reference { margin:10rpx 0 20rpx; }

.submitted-actions, .vote-edit-actions { display:flex; gap:16rpx; align-items:center; margin-top:24rpx; }
.submitted-actions button, .vote-edit-actions button { flex:1; min-width:0; width:auto; margin:0; padding:0 12rpx; font-size:26rpx; line-height:80rpx; }
button.submitted-confirmation[disabled], button.edit-time-button[disabled] { background:#e9edf3; color:#7a8596; }
.saved-slot-choice { margin-top:18rpx; color:#536582; font-size:26rpx; }

input.meeting-link-input { height:88rpx; min-height:88rpx; padding:0 20rpx; font-size:28rpx; line-height:normal; margin-bottom:12rpx; }
.meeting-link-text { display:block; background:#f4f6fa; border-radius:12rpx; padding:20rpx; margin-top:12rpx; font-size:26rpx; line-height:1.6; word-break:break-all; }
.notice-copy-error { color:#a32424; font-size:25rpx; line-height:1.6; margin-top:16rpx; }

.heat-conflict { background:#fbe1e5; color:#7d2937; }

.heat-breakdown { font-size:24rpx; line-height:1.6; overflow-wrap:break-word; word-break:break-all; }
.heat-breakdown > view + view { margin-top:4rpx; }

.owner-heatmap-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:16rpx; }
.owner-heatmap-heading .heading { flex:1; min-width:0; margin-bottom:0; }
button.lock-trigger { flex-shrink:0; width:160rpx; padding:0 12rpx; margin:0; font-size:26rpx; line-height:72rpx; }
.lock-picker-overlay { position:fixed; top:0; bottom:0; left:0; right:0; z-index:110; display:flex; align-items:center; justify-content:center; background:rgba(20,32,52,.4); padding:32rpx; }
.lock-picker-dialog { width:100%; max-width:650rpx; box-sizing:border-box; border-radius:28rpx; padding:32rpx; background:#fff; }
.lock-options { margin:24rpx 0; max-height:45vh; }
button.lock-option { box-sizing:border-box; width:100%; min-height:96rpx; padding:20rpx 12rpx; line-height:1.6; font-size:28rpx; background:#edf3ff; color:#244c9e; margin:0 0 16rpx; }
.lock-empty { margin-top:24rpx; }
.lock-picker-error { color:#a32424; font-size:25rpx; line-height:1.6; margin-top:16rpx; }

.proposal-overlay { z-index:120; }
.proposal-dialog { width:100%; max-width:650rpx; box-sizing:border-box; padding:32rpx; border-radius:28rpx; background:#fff; max-height:90vh; overflow-y:auto; }
.proposal-duration-row { display:flex; align-items:baseline; flex-wrap:wrap; gap:12rpx; margin:4rpx 0 14rpx; }
.proposal-duration { color:#162339; font-size:30rpx; font-weight:700; line-height:1.5; }
.proposal-pickers { flex-wrap:wrap; margin:16rpx 0; }
.proposal-pickers date-time-picker { flex:1 1 260rpx; min-width:0; }
.proposal-range { color:#244c9e; font-size:26rpx; line-height:1.7; margin:16rpx 0; overflow-wrap:break-word; }
.slot-header { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8rpx; margin-bottom:6rpx; }
.slot-header .slot-date { flex-shrink:1; margin-bottom:0; }
.heatcell .slot-header .slot-date { font-size:22rpx; }
.slot-header .proposal-badge { flex-shrink:1; min-width:0; font-size:20rpx; line-height:1.4; padding:4rpx 8rpx; margin:0 0 0 auto; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.supplement-owner-note { color:#68758a; font-size:25rpx; line-height:1.7; overflow-wrap:break-word; }

.final-time { font-size:28rpx; line-height:1.5; overflow-wrap:break-word; }
.lock-picker-dialog { max-height:90vh; overflow-y:auto; }
.row date-time-picker { flex:1 1 240rpx; min-width:0; }
