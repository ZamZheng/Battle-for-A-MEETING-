:host { display:block; min-width:0; }
.date-time-trigger { box-sizing:border-box; padding:20rpx; background:#f4f6fa; border-radius:12rpx; margin-top:12rpx; font-size:28rpx; line-height:1.45; color:#162339; overflow-wrap:break-word; }
.date-time-trigger.centered { text-align:center; white-space:nowrap; overflow-wrap:normal; }
.disabled { opacity:.5; }
.date-time-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:10000; display:flex; align-items:flex-end; background:rgba(20,32,52,.4); }
.date-time-backdrop { position:absolute; top:0; right:0; bottom:0; left:0; }
.date-time-panel { position:relative; z-index:1; width:100%; background:#fff; border-radius:28rpx 28rpx 0 0; padding-bottom:env(safe-area-inset-bottom); }
.date-time-actions { display:flex; align-items:center; justify-content:space-between; padding:16rpx 20rpx; font-size:30rpx; }
.date-time-actions button { width:auto; background:transparent; margin:0; padding:10rpx 16rpx; font-size:30rpx; line-height:1.5; }
.date-time-actions button::after { border:0; }
.date-time-actions .confirm { color:#315fe9; }
.date-time-actions button[disabled] { color:#9aa4b4; }
.date-time-wheel { width:100%; height:500rpx; max-height:65vh; }
.wheel-column { flex:1; }
.date-column-0 { flex:2; }
.date-column-1 { flex:1.3; }
.date-column-2 { flex:3.5; }
.wheel-option { display:flex; align-items:center; justify-content:center; height:100rpx; font-size:42rpx; color:#162339; white-space:nowrap; }
